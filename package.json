{
  "name": "pharmacy-pms",
  "version": "1.0.0",
  "description": "Pharmacy Practice Management System (PMS)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "pharmacy",
    "pms",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.14.0",
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.yourcompany.pharmacypms",
    "productName": "Pharmacy PMS",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}